<Project Sdk="Microsoft.NET.Sdk.Web" InitialTargets="TakeAppOffline">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ProjectGuid>{D92E5D79-8D6B-410F-B9FC-0FCE46FBC116}</ProjectGuid>
    <AssemblyTitle>Shrooms.Presentation.Api</AssemblyTitle>
    <Product>Shrooms.Presentation.Api</Product>
    <NoWarn>1591</NoWarn>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.18" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.18" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
    <PackageReference Include="SixLabors.ImageSharp.Web" Version="3.1.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="X.PagedList" Version="10.5.9" />
    <PackageReference Include="X.PagedList.EF" Version="10.5.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="EmailTemplates\**\*.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shrooms.IoC\Shrooms.IoC.csproj" />
  </ItemGroup>

  <Target Name="TakeAppOffline" Condition="'$(Configuration)' == 'Debug'">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\app_offline.htm" Lines="&lt;!-- Deploying... --&gt;" Overwrite="true" />
    <Exec Command="ping -n 11 127.0.0.1 &gt; nul" />
  </Target>

  <Target Name="BringAppOnline" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Delete Files="$(MSBuildProjectDirectory)\app_offline.htm" />
  </Target>

</Project>
