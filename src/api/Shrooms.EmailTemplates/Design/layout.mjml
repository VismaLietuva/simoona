<!-- Source for EmailTemplates/HeaderFooter.cshtml. See Design/README.md to regenerate. -->
<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Simoona</mj-title>
    <mj-raw>
      <meta name="color-scheme" content="light" />
      <meta name="supported-color-schemes" content="light" />
    </mj-raw>
    <mj-preview></mj-preview>
    <mj-font name="Roboto" href="" />
    <mj-attributes>
      <mj-all font-family="Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#0a0a0a" />
    </mj-attributes>
    <mj-style>
      a { color: #006199; }
      .simoona-footer a { color: #737373; text-decoration: underline; }
      /* Sidebar mark animation, lifted from globals.css. Keyframes draw FROM the hidden state
         so a client that strips `animation` still shows a fully drawn logo. */
      @keyframes mark-draw-bracket { from { stroke-dashoffset: 70; } to { stroke-dashoffset: 0; } }
      @keyframes mark-draw-slash { from { stroke-dashoffset: 46; } to { stroke-dashoffset: 0; } }
      @keyframes mark-brace-l { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-6px); } }
      @keyframes mark-brace-r { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(6px); } }
      @keyframes mark-slash-pulse {
        0% { transform: translateY(0) rotate(0); }
        50% { transform: translateY(-3px) rotate(8deg); }
        100% { transform: translateY(0) rotate(0); }
      }
      @keyframes mark-draw-bracket-h { from { stroke-dashoffset: 70; } to { stroke-dashoffset: 0; } }
      @keyframes mark-draw-slash-h { from { stroke-dashoffset: 46; } to { stroke-dashoffset: 0; } }
      @keyframes mark-brace-l-h { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-6px); } }
      @keyframes mark-brace-r-h { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(6px); } }
      @keyframes mark-slash-pulse-h {
        0% { transform: translateY(0) rotate(0); }
        50% { transform: translateY(-3px) rotate(8deg); }
        100% { transform: translateY(0) rotate(0); }
      }
      @media (prefers-reduced-motion: no-preference) {
        .mark-bracket-l, .mark-slash, .mark-bracket-r {
          transform-origin: center;
          transform-box: fill-box;
        }
        .mark-bracket-l, .mark-bracket-r { stroke-dasharray: 70; }
        .mark-slash { stroke-dasharray: 46; }
        .mark-bracket-l {
          animation: mark-draw-bracket .5s cubic-bezier(.65,0,.35,1) forwards, mark-brace-l 2s ease-in-out .6s;
        }
        .mark-slash {
          animation: mark-draw-slash .4s cubic-bezier(.65,0,.35,1) .15s forwards, mark-slash-pulse 2s ease-in-out .7s;
        }
        .mark-bracket-r {
          animation: mark-draw-bracket .5s cubic-bezier(.65,0,.35,1) forwards, mark-brace-r 2s ease-in-out .6s;
        }
        /* Replay on hover. The app remounts the SVG via a key bump; CSS needs distinct animation
           names, since re-applying an identical one does not restart it. */
        a:hover .mark-bracket-l {
          animation: mark-draw-bracket-h .5s cubic-bezier(.65,0,.35,1) forwards, mark-brace-l-h 2s ease-in-out .6s;
        }
        a:hover .mark-slash {
          animation: mark-draw-slash-h .4s cubic-bezier(.65,0,.35,1) .15s forwards, mark-slash-pulse-h 2s ease-in-out .7s;
        }
        a:hover .mark-bracket-r {
          animation: mark-draw-bracket-h .5s cubic-bezier(.65,0,.35,1) forwards, mark-brace-r-h 2s ease-in-out .6s;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f4f5f6" width="600px">
    <!-- The sidebar lockup: SimoonaMark SVG plus wordmark, linking home. Outlook and Gmail
         strip inline SVG, so an mso fallback and the always-text wordmark carry the brand there. -->
    <mj-section background-color="#f4f5f6" padding="24px 24px 0">
      <mj-column padding="0">
        <mj-text padding="0">
          <a href="https://simoona.com" target="_blank" style="text-decoration:none;">
            <table border="0" cellpadding="0" cellspacing="0" role="presentation">
              <tbody>
                <tr>
                  <td width="32" style="width:32px;height:32px;background-color:#fcfcfc;border:1px solid #e2e6e8;border-radius:8px;text-align:center;vertical-align:middle;line-height:30px;">
                    <!--[if !mso]><!-->
                    <svg width="20" height="20" viewBox="0 0 80 80" fill="none" style="vertical-align:middle;">
                      <path class="mark-bracket-l" d="M30 22 L14 40 L30 58" stroke="#006199" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
                      <path class="mark-slash" d="M46 20 L34 60" stroke="#4d8400" stroke-width="6" stroke-linecap="round" />
                      <path class="mark-bracket-r" d="M50 22 L66 40 L50 58" stroke="#3180bb" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <!--<![endif]-->
                    <!--[if mso]>
                    <span style="font-size:15px;font-weight:700;letter-spacing:-1px;"><span style="color:#006199;">&lt;</span><span style="color:#4d8400;">/</span><span style="color:#3180bb;">&gt;</span></span>
                    <![endif]-->
                  </td>
                  <td style="padding-left:10px;vertical-align:middle;font-size:18px;font-weight:600;line-height:32px;">
                    <span style="color:#006199;">S</span><span style="color:#4d8400;">/</span><span style="color:#3180bb;">moona</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Page ground only; cards are drawn by <email-card>. -->
    <mj-section background-color="#f4f5f6" padding="20px 24px 8px">
      <mj-column padding="0">
        <mj-text padding="0">CONTENT_SLOT</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f4f5f6" padding="8px 24px 32px">
      <mj-column>
        <mj-text css-class="simoona-footer" align="center" color="#737373" font-size="12px" padding="0 0 6px">
          <a href="https://simoona.com" target="_blank">www.simoona.com</a>
        </mj-text>
        <mj-text css-class="simoona-footer" align="center" color="#737373" font-size="12px" padding="0">
          Update your notification preferences <a href="SETTINGS_URL_SLOT" target="_blank">here</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
