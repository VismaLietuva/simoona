@model Shrooms.Contracts.DataTransferObjects.BaseEmailTemplateViewModel
@* Style reference: every shared partial in one place. Not sent to anyone. *@
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
}

<email-heading eyebrow="Design system" emphasis="foundation">Design</email-heading>
<email-card>
    <p style="margin:0 0 12px;">
        Body copy sits at 16px/24px, matching the app's base type. Inline <a href="https://simoona.com">links</a>
        take the primary blue, and <strong>bold</strong> carries emphasis.
    </p>
    <p style="margin:0;">
        Amounts use the semantic pair:
        <span style="color:@Shrooms.EmailTemplates.EmailDesign.Secondary;font-weight:600;">+25</span> received,
        <span style="color:@Shrooms.EmailTemplates.EmailDesign.Destructive;font-weight:600;">-15</span> decreased.
    </p>

    <email-quote>
        Quoted user content keeps its word-break guards, because this is the text most likely to
        arrive as one unbroken string: Supercalifragilisticexpialidocious.
    </email-quote>

    <email-details>
        <email-detail label="Location">Vilnius HQ, 4th floor</email-detail>
        <email-detail label="Starts">2026-03-17 09:30</email-detail>
        <email-detail label="Registration closes">2026-03-14 17:00</email-detail>
    </email-details>

    <email-button href="https://simoona.com">Primary action</email-button>
</email-card>
