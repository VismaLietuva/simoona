@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.NotificationAboutNewUserEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
}

<email-heading eyebrow="Account" emphasis="confirmation">New user awaits</email-heading>
<email-card>
    <p style="margin:0;">
        New user "<strong>@Model.NewUserName</strong>" has filled out necessary information and is
        waiting to be confirmed.
    </p>
    <email-button href="@Model.NewUserProfileUrl">Visit user profile</email-button>
</email-card>
