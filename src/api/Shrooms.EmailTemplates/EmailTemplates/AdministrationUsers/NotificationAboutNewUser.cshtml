@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.NotificationAboutNewUserEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"{Model.NewUserName} finished registering and needs confirming.";
}

<email-heading eyebrow="Account">New user awaits <email-em>confirmation</email-em></email-heading>
<email-card>
    <p style="margin:0;">
        New user "<strong>@Model.NewUserName</strong>" has filled out necessary information and is
        waiting to be confirmed.
    </p>
    <email-button href="@Model.NewUserProfileUrl">Review the profile</email-button>
</email-card>
