@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.ResetPasswordTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = "Use the link inside to choose a new password. Ignore this if it was not you.";
}

<email-heading eyebrow="Account">Reset your <email-em>password</email-em></email-heading>
<email-card>
    <p style="margin:0 0 12px;">Hi @Model.FullName</p>
    <p style="margin:0;">
        We've received a request to reset your password. If you didn't make the request just ignore
        this email. Otherwise, you can reset your password using the button below.
    </p>
    <email-button href="@Model.ResetUrl">Reset password</email-button>
</email-card>
