@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.VerifyEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = "Confirm your address to finish setting up Simoona.";
}

<email-heading eyebrow="Account">Verify your <email-em>email</email-em></email-heading>
<email-card>
    <p style="margin:0 0 12px;">Hi @Model.FullName</p>
    <p style="margin:0;">
        Please verify your email address. If you didn't make the request just ignore this email.
    </p>
    <email-button href="@Model.VerifyUrl">Verify email</email-button>
</email-card>
