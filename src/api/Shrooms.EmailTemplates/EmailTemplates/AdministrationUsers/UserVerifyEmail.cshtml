@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.VerifyEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
}

<email-heading eyebrow="Account" emphasis="E-mail">Verify</email-heading>
<email-card>
    <p style="margin:0 0 12px;">Hi, @Model.FullName</p>
    <p style="margin:0;">
        Please verify your e-mail address. If you didn't make the request just ignore this e-mail.
        Otherwise, you can verify your e-mail using the button below.
    </p>
    <email-button href="@Model.VerifyUrl">Click here to verify your e-mail</email-button>
</email-card>
