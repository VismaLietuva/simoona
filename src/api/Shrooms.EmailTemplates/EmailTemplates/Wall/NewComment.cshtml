@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.NewCommentEmailTemplateViewModel
@using Shrooms.Domain.Helpers
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"{Model.FullName} replied to the post.";
}

<email-heading eyebrow="Wall">@Model.PostCommentTitle</email-heading>
<email-card>
    <p style="margin:0;"><strong>@Model.FullName</strong> commented:</p>
    <email-quote>@Html.Raw(HtmlSanitizerHelper.Sanitize(Model.MessageBody))</email-quote>
    <email-button href="@Model.PostDeepLink">@Model.ActionButtonTitle</email-button>
</email-card>
