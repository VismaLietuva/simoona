@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.BirthdaysNotificationTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"{Model.Employees.Count()} to congratulate today.";
}

<email-heading eyebrow="Birthdays">Birthdays <email-em>today</email-em></email-heading>
<email-card>
    <p style="margin:0 0 12px;">Do not forget to congratulate:</p>
    @foreach (var employee in Model.Employees)
    {
        <p style="margin:0 0 6px;"><a href="@employee.ProfileUrl">@employee.FullName</a></p>
    }
</email-card>
