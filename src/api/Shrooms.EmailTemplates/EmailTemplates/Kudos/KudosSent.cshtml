@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.KudosSentEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"{Model.KudosSenderName} sent you {Model.KudosAmount} kudos.";
}

<email-heading eyebrow="Kudos">@Model.KudosSenderName sent you <email-em>@Model.KudosAmount kudos</email-em></email-heading>
<email-card>
    <p style="margin:0;">
        <span style="color:@Shrooms.EmailTemplates.EmailDesign.Secondary;font-weight:600;">+@Model.KudosAmount</span>
        added to your balance.
    </p>
    <email-quote>@Model.Comment</email-quote>
    <email-button href="@Model.KudosProfileUrl">View your kudos</email-button>
</email-card>
