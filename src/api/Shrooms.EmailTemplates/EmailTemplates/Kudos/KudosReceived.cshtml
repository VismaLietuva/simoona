@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.KudosReceivedDecreasedEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    var amount = Model.KudosAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    // No sender for automatic awards or when the sender's account is gone.
    var hasSender = !string.IsNullOrWhiteSpace(Model.KudosSenderName);
    ViewData["Preheader"] = hasSender
        ? $"{Model.KudosSenderName} sent you {amount} kudos for \"{Model.KudosType}\"."
        : $"You received {amount} kudos for \"{Model.KudosType}\".";
}

<email-heading eyebrow="Kudos">You received <email-em>@amount kudos</email-em></email-heading>
<email-card>
    <p style="margin:0;">
        <span style="color:@Shrooms.EmailTemplates.EmailDesign.Secondary;font-weight:600;">+@amount</span>
        for "@Model.KudosType"@if (hasSender) {<text>, from <strong>@Model.KudosSenderName</strong></text>}.
    </p>
    <email-quote>@Model.Comment</email-quote>
    <email-button href="@Model.KudosProfileUrl">View your kudos</email-button>
</email-card>
