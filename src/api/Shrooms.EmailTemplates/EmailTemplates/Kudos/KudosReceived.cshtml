@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.KudosReceivedDecreasedEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
}

<email-heading eyebrow="Kudos" emphasis="notification">Kudos</email-heading>
<email-card>
    <p style="margin:0;">
        You have received
        <span style="color:@Shrooms.EmailTemplates.EmailDesign.Secondary;font-weight:600;">+@Model.KudosAmount</span>
        kudos for "@Model.KudosType" from <strong>@Model.KudosSenderName</strong>.
    </p>
    <email-quote>@Model.Comment</email-quote>
    <email-button href="@Model.KudosProfileUrl">Visit your kudos profile</email-button>
</email-card>
