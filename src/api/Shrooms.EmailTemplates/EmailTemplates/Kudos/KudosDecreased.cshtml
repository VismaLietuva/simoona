@model Shrooms.Contracts.DataTransferObjects.EmailTemplateViewModels.KudosReceivedDecreasedEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    var amount = Model.KudosAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    // No sender for automatic changes or when the sender's account is gone.
    var hasSender = !string.IsNullOrWhiteSpace(Model.KudosSenderName);
    ViewData["Preheader"] = hasSender
        ? $"{Model.KudosSenderName} reduced your kudos by {amount}."
        : $"Your kudos were reduced by {amount}.";
}

<email-heading eyebrow="Kudos">Your kudos were <email-em>reduced</email-em></email-heading>
<email-card>
    <p style="margin:0;">
        <span style="color:@Shrooms.EmailTemplates.EmailDesign.Destructive;font-weight:600;">-@amount</span>@if (hasSender) {<text> by <strong>@Model.KudosSenderName</strong></text>}.
    </p>
    <email-quote>@Model.Comment</email-quote>
    <email-button href="@Model.KudosProfileUrl">View your kudos</email-button>
</email-card>
