<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyTitle>Shrooms.EmailTemplates.Tests</AssemblyTitle>
    <Product>Shrooms.EmailTemplates.Tests</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Razor.Templating.Core" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="GoldenFiles\**\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Compared against each other by LayoutIsGeneratedTests. -->
    <Content Include="..\Shrooms.EmailTemplates\Design\layout.html" Link="Layout\layout.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Shrooms.EmailTemplates\EmailTemplates\HeaderFooter.cshtml" Link="Layout\HeaderFooter.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shrooms.EmailTemplates\Shrooms.EmailTemplates.csproj" />
    <ProjectReference Include="..\Shrooms.EmailTemplates.Premium\Shrooms.EmailTemplates.Premium.csproj" />
    <ProjectReference Include="..\Shrooms.EmailTemplates.Seeds\Shrooms.EmailTemplates.Seeds.csproj" />
    <ProjectReference Include="..\Shrooms.Infrastructure\Shrooms.Infrastructure.csproj" />
  </ItemGroup>

</Project>
