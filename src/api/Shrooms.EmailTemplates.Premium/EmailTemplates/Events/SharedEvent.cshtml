@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.SharedEventEmailTemplateViewModel
@using Shrooms.Domain.Helpers
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
}

<email-heading eyebrow="Events">@Model.WallName</email-heading>
<email-card>
    <p style="margin:0;"><strong>@Model.SharerFullName</strong> shared an event:</p>
    <email-quote>@Html.Raw(HtmlSanitizerHelper.Sanitize(Model.PostBody))</email-quote>
    <p style="margin:16px 0 0;">
        📆 <a href="@Model.EventUrl"><strong>@Model.EventName</strong></a>
    </p>
    <email-details>
        <email-detail label="Location">@Model.Location</email-detail>
        <email-detail label="Starts">@Model.StartDate.ToString("yyyy-MM-dd HH:mm")</email-detail>
    </email-details>
    @if (string.IsNullOrEmpty(Model.Description))
    {
        <p style="margin:0;color:@Shrooms.EmailTemplates.EmailDesign.MutedForeground;">No description provided</p>
    }
    else
    {
        <email-quote>@Html.Raw(HtmlSanitizerHelper.Sanitize(Model.Description))</email-quote>
    }
    <email-button href="@Model.PostUrl">Check out in Simoona</email-button>
</email-card>
