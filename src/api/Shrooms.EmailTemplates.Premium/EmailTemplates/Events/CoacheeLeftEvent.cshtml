@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.CoacheeLeftEventEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"{Model.CoacheeFullName} will no longer attend {Model.EventName}.";
}

<email-heading eyebrow="Events">@Model.CoacheeFullName left <email-em>@Model.EventName</email-em></email-heading>
<email-card>
    <p style="margin:0;">
        This is an informational notice, no action is needed.
    </p>
    <email-button href="@Model.EventUrl">Open the event</email-button>
</email-card>
