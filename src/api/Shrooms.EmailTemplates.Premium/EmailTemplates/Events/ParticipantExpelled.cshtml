@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.EventParticipantExpelledEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"You are no longer registered for {Model.EventTitle}.";
}

<email-heading eyebrow="Events">You were <email-em>removed</email-em> from an event</email-heading>
<email-card>
    <p style="margin:0;">"<strong>@Model.EventTitle</strong>"</p>
    <email-button href="@Model.EventUrl">Open the event</email-button>
</email-card>
