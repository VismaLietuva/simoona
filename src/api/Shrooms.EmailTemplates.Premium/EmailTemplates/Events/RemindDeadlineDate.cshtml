@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.EventReminderDeadlineEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"Registration for {Model.Name} closes {Model.DeadlineDate:yyyy-MM-dd HH:mm}.";
}

<email-heading eyebrow="Events">Registration closes soon for @Model.Name event</email-heading>
<email-card>
    <p style="margin:0;">
        We remind you that you are registered for the event, which will take place on
        @Model.StartDate.ToString("yyyy-MM-dd HH:mm"). The registration deadline is coming to an end
        (@Model.DeadlineDate.ToString("yyyy-MM-dd HH:mm")), so please update your registration in
        case of any changes.
    </p>
    <email-button href="@Model.Url">Open the event</email-button>
</email-card>
