@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.EventJoinRemindEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = "You have not joined a weekly event yet.";
}

<email-heading eyebrow="Events">Do not miss out <email-em>this week</email-em></email-heading>
<email-card>
    <p style="margin:0;">We see you did not join any weekly event this week.</p>
    @foreach (var eventType in Model.EventTypes)
    {
        <p style="margin:12px 0 0;"><a href="@eventType.Value">@eventType.Key events</a></p>
    }
</email-card>
