@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.LotteryTicketGiftedEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
}

<email-heading eyebrow="Lotteries" emphasis="ticket/s!">You were gifted lottery</email-heading>
<email-card>
    <p style="margin:0;">
        <strong>@Model.BuyerFullName</strong> has gifted you
        <span style="color:@Shrooms.EmailTemplates.EmailDesign.Secondary;font-weight:600;">@Model.GiftedTicketCount</span>
        ticket/s for the "@Model.LotteryTitle" lottery!
    </p>
    <email-button href="@Model.LotteryUrl">Check out in Simoona</email-button>
</email-card>
