@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.ServiceRequestCommentEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
}

<email-heading eyebrow="Service requests" emphasis="Request">New comment in Service</email-heading>
<email-card>
    <p style="margin:0;">"<strong>@Model.ServiceRequestTitle</strong>"</p>
    <p style="margin:12px 0 0;">@Model.FullName commented:</p>
    <email-quote>@Model.Comment</email-quote>
    <email-button href="@Model.Url">Service Request in Simoona</email-button>
</email-card>
