@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.BookTakenEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"\"{Model.BookTitle}\" is now marked as taken.";
}

<email-heading eyebrow="Books">Book registered as <email-em>taken</email-em></email-heading>
<email-card>
    <p style="margin:0;">
        "<strong>@Model.BookTitle</strong>" by @Model.BookAuthor.
    </p>
    <email-button href="@Model.BookUrl">Open the book</email-button>
</email-card>
