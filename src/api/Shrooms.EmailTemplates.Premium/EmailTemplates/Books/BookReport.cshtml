@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.BookReportEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"{Model.FullName} reported \"{Model.Title}\".";
}

<email-heading eyebrow="Books">New book report by @Model.FullName</email-heading>
<email-card>
    <p style="margin:0;">
        "<strong>@Model.Title</strong>" by @Model.Author has been reported.
    </p>
    <email-details>
        <email-detail label="Report reason">@Model.Report</email-detail>
        @if (!string.IsNullOrWhiteSpace(Model.Comment))
        {
            <email-detail label="Report comment">@Model.Comment</email-detail>
        }
    </email-details>
    <email-button href="@Model.BookUrl">Open the book</email-button>
</email-card>
