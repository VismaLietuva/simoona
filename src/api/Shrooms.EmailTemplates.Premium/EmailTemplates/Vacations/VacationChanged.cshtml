@model Shrooms.Premium.DataTransferObjects.EmailTemplateViewModels.VacationSubmittedEmailTemplateViewModel
@{
    Layout = "/EmailTemplates/HeaderFooter.cshtml";
    ViewData["Preheader"] = $"{Model.EmployeeName}: {Model.Period}, changed by {Model.ActorName}.";
}

<email-heading eyebrow="Vacation">A leave request <email-em>changed</email-em></email-heading>
<email-card>
    <p style="margin:0;">
        @if (Model.ActorName == Model.EmployeeName)
        {
            <text><strong>@Model.EmployeeName</strong> changed their own request, so it is waiting for approval again.</text>
        }
        else
        {
            <text><strong>@Model.ActorName</strong> changed @Model.EmployeeName's request, so it is waiting for approval again.</text>
        }
    </p>
    <email-details>
        <email-detail label="Period">@Model.Period</email-detail>
        <email-detail label="Type">@Model.LeaveType</email-detail>
        <email-detail label="Working days">@Model.WorkingDays</email-detail>
    </email-details>
    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <email-quote>@Model.Note</email-quote>
    }
    @if (string.IsNullOrEmpty(Model.ApproveUrl))
    {
        <email-button href="@Model.RequestUrl">Open the request</email-button>
    }
    else
    {
        <email-actions>
            <email-action>
                <email-button href="@Model.ApproveUrl">Approve</email-button>
            </email-action>
            <email-action>
                <email-button href="@Model.RejectUrl" variant="outline">Reject</email-button>
            </email-action>
        </email-actions>
    }
</email-card>
