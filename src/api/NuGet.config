<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only nuget.org: feeds from user or machine NuGet configs must not take part in restore. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>